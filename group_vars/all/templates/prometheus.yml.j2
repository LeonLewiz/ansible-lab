global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /usr/local/bin/prometheus/rules.yml

scrape_configs:
  - job_name: node
    static_configs:
      - targets:
{% for host in groups['managed'] %}
{% set ip = hostvars[host]['ansible_host'] %}
          - '{{ ip }}:9100'
{% endfor %}
          - '192.168.13.130:9100'

  - job_name: cadvisor
    static_configs:
      - targets:
{% for host in groups['managed'] %}
{% set ip = hostvars[host]['ansible_host'] %}
          - '{{ ip }}:8080'
{% endfor %}

  - job_name: prometheus
    static_configs:
      - targets:
          - 'localhost:9090'

  - job_name: blackbox
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for host in groups['managed'] %}
{% set ip = hostvars[host]['ansible_host'] %}
          - '{{ ip }}:9090'
{% endfor %}
    relabel_configs:
      - source_labels: [__scheme__, __address__]
        separator: "://"
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: '127.0.0.1:9115'

  - job_name: blackbox_exporter
    static_configs:
      - targets:
          - '127.0.0.1:9115'

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - 'localhost:9093'
