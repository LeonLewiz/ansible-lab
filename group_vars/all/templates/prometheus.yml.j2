global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: node
    static_configs:
      - targets:
          - 192.168.13.133:9100
          - 192.168.13.130:9100
          - 192.168.13.134:9100
  - job_name: cadvisor
    static_configs:
      - targets:
          - 192.168.13.133:8080
          - 192.168.13.134:8080
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
